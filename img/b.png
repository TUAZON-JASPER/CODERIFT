ubgmobileesports&h=AT04thHQb746vX8q4SZBLKJRly-bDdhD2Ip8qaW4qC2-moKWUOl-jiAZuCwMIl1vPSLCSeAMpeKplXY-ee1siGh0XO_SK4Oh42hHIGiY6VS0dF4AvcZoS-OCULNoMuPq-U9a0HU-BcshTTsy9d4A&s=1","__isNode":"ExternalUrl","id":"NjQyMTgzOTU5MjA4MTA3Omh0dHBzXGEvL3d3dy50aWt0b2suY29tL0BwdWJnbW9iaWxlZXNwb3J0czo6Ojo="},"entity_is_weak_reference":false,"length":41,"offset":2143},{"entity":{"__typename":"Hashtag","__isEntity":"Hashtag","url":"https:\/\/www.facebook.com\/hashtag\/pmgc2024?__eep__=6","mobileUrl":"https:\/\/m.facebook.com\/hashtag\/pmgc2024","__isNode":"Hashtag","id":"6512876122059117"},"entity_is_weak_reference":false,"length":9,"offset":665},{"entity":{"__typename":"Hashtag","__isEntity":"Hashtag","url":"https:\/\/www.facebook.com\/hashtag\/pmgc2024?__eep__=6","mobileUrl":"https:\/\/m.facebook.com\/hashtag\/pmgc2024","__isNode":"Hashtag","id":"6512876122059117"},"entity_is_weak_reference":false,"length":9,"offset":1832},{"entity":{"__typename":"Hashtag","__isEntity":"Hashtag","url":"https:\/\/www.facebook.com\/hashtag\/pubgmesports?__eep__=6","mobileUrl":"https:\/\/m.facebook.com\/hashtag\/pubgmesports","__isNode":"Hashtag","id":"2231406173589630"},"entity_is_weak_reference":false,"length":13,"offset":1842},{"entity":{"__typename":"Hashtag","__isEntity":"Hashtag","url":"https:\/\/www.facebook.com\/hashtag\/pubgmobile?__eep__=6","mobileUrl":"https:\/\/m.facebook.com\/hashtag\/pubgmobile","__isNode":"Hashtag","id":"1230289040409214"},"entity_is_weak_reference":false,"length":11,"offset":1856}],"color_ranges":[],"text":"Ang 2024 PUBG MOBILE Global Championship Grand Finals ay magsisimula na ngayong araw! Nasaksihan natin ang mga pinakamahuhusay na koponan na nagtagumpay sa PMGC League stage gamit ang mga nakakabilib na galaw, clutch moments, at kamangha-manghang mga estratehiya upang makapasok sa Grand Finals! Ngayon, oras na upang panoorin sila sa London, habang sinisikap nilang maabot ang 2024 PMGC Trophy sa loob ng susunod na 3 araw upang patunayan kung sino ang tunay na karapat-dapat!\n\nKahit ikaw ay sumusuporta sa iyong paboritong koponan, kumakampi sa isang team mula sa iyong bansa, o nandito para lamang sa kasabikan ng pinakamataas na antas ng esports na aksyon, ang #PMGC2024 ang ultimate na destinasyon para sa mga di-malilimutang sandali. Ang PMGC League ay live mula sa Malaysia at nagtagal ng apat na linggong nagpakita ng mga pinakamahusay na PUBG MOBILE teams na lumaban para sa mga puwesto sa Grand Finals. Mula sa 48 na koponan, ang matinding League Stage ay nagbawas sa mga kalahok, at ngayon ang mga nangungunang team na ang maghaharap sa Grand Finals!\n\nAng PMGC Grand Finals ay live mula sa London at ito ang huling yugto para patunayan ng mga koponan na sila ay karapat-dapat na mag-angat ng PMGC Trophy bilang kampeon ng 2024 PMGC! Sino ang paborito mo? Ipaalam sa amin sa chat!\n\nTry PUBG MOBILE now: https:\/\/pubgmobile.live\/24pmgclive\n\ud83d\udcb0Total Prize Pool: $3,000,000\n\n\ud83d\uddd3\ufe0f PMGC Grand Finals: 6-7-8 Dec\n\ud83c\udfc6Grand Finals Teams\ud83c\udfc6\n4Merical Vibes\nALPHA 7 ESPORTS\nDplus KIA\nDRX\nFalcons Force\nGuild Esports\nINFLUENCE RAGE\nINSILIO\nNATUS VINCERE\nNIGMA GALAXY\nREGNUM CARYA BRA ESPORTS\nTJB Esports\nTEAM SPIRIT\nThunderTalk Gaming\nTHE VICIOUS\nVOIN DONKEY ID\n\nDaily Map Rotation\nMatch \u2694\ufe0f1: Sanhok\nMatch \u2694\ufe0f2: Erangel\nMatch \u2694\ufe0f3: Erangel\nMatch \u2694\ufe0f4: Erangel\nMatch \u2694\ufe0f5: Miramar\nMatch \u2694\ufe0f6: Miramar\n\n\ud83d\udccdGrand Finals Location: London, United Kingdom\n\n#PMGC2024 #PUBGMESPORTS #PUBGMOBILE\nFollow us:\nFacebook - https:\/\/www.facebook.com\/PUBGMESPORTSOFFICIAL\nYouTube - https:\/\/www.youtube.com\/c\/pubgmobileesports\nInstagram - https:\/\/instagram.com\/esportspubgmobile\nTwitter - https:\/\/twitter.com\/EsportsPUBGM\nTwitch - https:\/\/www.twitch.tv\/pubgmobileesports\nTikTok - https:\/\/www.tiktok.com\/\u0040pubgmobileesports"},"message_truncation_line_limit":null,"id":""},"__module_operation_CometFeedStoryMessageMatchRenderer_story":{"__dr":"CometFeedStoryDefaultMessageRenderingStrategy_message$normalization.graphql"},"__module_component_CometFeedStoryMessageMatchRenderer_story":{"__dr":"CometFeedStoryDefaultMessageRenderingStrategy.react"}},"message_suffix":null,"message_container":{"__typename":"CometFeedStoryMessageContainerRenderingStrategy","__isICometStorySection":"CometFeedStoryMessageContainerRenderingStrategy","is_prod_eligible":true,"story":{"message":{"text":"Ang 2024 PUBG MOBILE Global Championship Grand Finals ay magsisimula na ngayong araw! Nasaksihan natin ang mga pinakamahuhusay na koponan na nagtagumpay sa PMGC League stage gamit ang mga nakakabilib na galaw, clutch moments, at kamangha-manghang mga estratehiya upang makapasok sa Grand Finals! Ngayon, oras na upang panoorin sila sa London, habang sinisikap nilang maabot ang 2024 PMGC Trophy sa loob ng susunod na 3 araw upang patunayan kung sino ang tunay na karapat-dapat!\n\nKahit ikaw ay sumusuporta sa iyong paboritong koponan, kumakampi sa isang team mula sa iyong bansa, o nandito para lamang sa kasabikan ng pinakamataas na antas ng esports na aksyon, ang #PMGC2024 ang ultimate na destinasyon para sa mga di-malilimutang sandali. Ang PMGC League ay live mula sa Malaysia at nagtagal ng apat na linggong nagpakita ng mga pinakamahusay na PUBG MOBILE teams na lumaban para sa mga puwesto sa Grand Finals. Mula sa 48 na koponan, ang matinding League Stage ay nagbawas sa mga kalahok, at ngayon ang mga nangungunang team na ang maghaharap sa Grand Finals!\n\nAng PMGC Grand Finals ay live mula sa London at ito ang huling yugto para patunayan ng mga koponan na sila ay karapat-dapat na mag-angat ng PMGC Trophy bilang kampeon ng 2024 PMGC! Sino ang paborito mo? Ipaalam sa amin sa chat!\n\nTry PUBG MOBILE now: https:\/\/pubgmobile.live\/24pmgclive\n\ud83d\udcb0Total Prize Pool: $3,000,000\n\n\ud83d\uddd3\ufe0f PMGC Grand Finals: 6-7-8 Dec\n\ud83c\udfc6Grand Finals Teams\ud83c\udfc6\n4Merical Vibes\nALPHA 7 ESPORTS\nDplus KIA\nDRX\nFalcons Force\nGuild Esports\nINFLUENCE RAGE\nINSILIO\nNATUS VINCERE\nNIGMA GALAXY\nREGNUM CARYA BRA ESPORTS\nTJB Esports\nTEAM SPIRIT\nThunderTalk Gaming\nTHE VICIOUS\nVOIN DONKEY ID\n\nDaily Map Rotation\nMatch \u2694\ufe0f1: Sanhok\nMatch \u2694\ufe0f2: Erangel\nMatch \u2694\ufe0f3: Erangel\nMatch \u2694\ufe0f4: Erangel\nMatch \u2694\ufe0f5: Miramar\nMatch \u2694\ufe0f6: Miramar\n\n\ud83d\udccdGrand Finals Location: London, United Kingdom\n\n#PMGC2024 #PUBGMESPORTS #PUBGMOBILE\nFollow us:\nFacebook - https:\/\/www.facebook.com\/PUBGMESPORTSOFFICIAL\nYouTube - https:\/\/www.youtube.com\/c\/pubgmobileesports\nInstagram - https:\/\/instagram.com\/esportspubgmobile\nTwitter - https:\/\/twitter.com\/EsportsPUBGM\nTwitch - https:\/\/www.twitch.tv\/pubgmobileesports\nTikTok - https:\/\/www.tiktok.com\/\u0040pubgmobileesports"},"referenced_sticker":null,"attachments":[{"style_list":["video_autoplay","video_inline","video","games_app","fallback"]}],"text_format_metadata":null,"comet_sections":{"message":null},"id":""},"__module_operation_CometFeedStoryMessageContainerMatchRenderer_story":{"__dr":"CometFeedStoryMessageContainerRenderingStrategy_messageContainer$normalization.graphql"},"__module_component_CometFeedStoryMessageContainerMatchRenderer_story":{"__dr":"CometFeedStoryMessageContainerRenderingStrategy.react"}},"message_sticker":null,"aggregated_stories":null},"encrypted_tracking":"AZW7YlFP8IgJcA6ndjptT0ImbWdjSKxHu_5wtDADfxV_uOnFFfNIBc5W4vCQx5KL0xcbAHAp93So2gFS1cNf8BgddoYG8FOL44fsNk_9xF1uRMNq7nGscV9kHM3wUNaBDx759POW41Yezp-gcCRGw1IjhmMhPFgMshKSZBAvTxGYi9emfeMGnqE8ImzVONNrYG4AIKB03br3DxikFOWkyJwkoULVrOF5LMuA8iGZ5K1zpzOejmtfkGfTijI6bH_dbKVdUYlzXfTergrbkzPEenYMucFydO-hAYnYnvCNaeKfkGVyZOyxEhGSYgQW9W5t5rWUuqs-zCjsRalceoOLFQcWHIdS1YDYUi_9GnGRmhvc1UeBRrBmmxwlPdohnYosdt83DshjgtPjmxoFKQ4d8IRvHy-ZIstYVhacs4F6AKRZ7aIhZw88J4Ypr6f1V7PE3I9NsajV3RltoxKEtL40UqR1MOBnrvWshFecQDQO0oBZUJyMIzYChxbbwKqnvV4YS2Yl1NRjDr9aLmX4PQXFo7pnLJ4bGTFT3WgrHL59x0SufV-kbLXbB0Ostr0sloXV0ldyISmO8frc1q